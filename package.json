{
  "name": "exa-cli",
  "version": "0.0.1",
  "description": "A command-line interface for the Exa search API.",
  "type": "module",
  "bin": {
    "exa": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "format": "biome format --write src",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "exa",
    "search",
    "cli",
    "ai",
    "web-search"
  ],
  "author": "Qian Zhang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AirswitchAsa/exa-cli.git"
  },
  "bugs": {
    "url": "https://github.com/AirswitchAsa/exa-cli/issues"
  },
  "homepage": "https://github.com/AirswitchAsa/exa-cli#readme",
  "dependencies": {
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
