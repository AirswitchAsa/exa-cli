{
  "name": "@spicadust/exa-cli",
  "version": "0.2.0",
  "description": "Unofficial command-line interface for the Exa API. Not affiliated with Exa.",
  "type": "module",
  "bin": {
    "exa-cli": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && chmod +x dist/cli.js",
    "build:bun": "bun build src/cli.ts --compile --outfile dist-bin/exa-cli",
    "build:bun:all": "for t in bun-darwin-arm64 bun-linux-x64 bun-linux-arm64 bun-windows-x64; do bun build src/cli.ts --compile --target=$t --outfile dist-bin/exa-cli-${t#bun-}; done",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:integration": "npm run build && node --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "format": "biome format --write src tests",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "exa",
    "search",
    "cli",
    "ai",
    "web-search"
  ],
  "author": "Qian Zhang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AirswitchAsa/exa-cli.git"
  },
  "bugs": {
    "url": "https://github.com/AirswitchAsa/exa-cli/issues"
  },
  "homepage": "https://github.com/AirswitchAsa/exa-cli#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "yaml": "^2.9.0"
  }
}
